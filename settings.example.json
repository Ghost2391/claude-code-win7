  "activeProviderProfile": "antigravity-manager",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/notify_pet.py --event coding",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/notify_pet.py --event complete",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/notify_pet.py --event attention",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/notify_pet.py --event user_choice",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLineEnabled": true,
  "skipDangerousModePermissionPrompt": true
}
